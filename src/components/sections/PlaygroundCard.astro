---
// Seção 05 ("Por diversão"): um app feito por diversão. Ícone + nome, a tagline em linguagem de
// leigo, o "por que eu fiz" na voz do Yuri, as tecnologias e os links (código sempre, demo quando
// existe). Sem capa, sem selo e sem página de detalhe de propósito: ver playgroundSchema.
// O cartão é <li>, então vive dentro do <ul class="playground"> de HomePage.astro.
import Icon from "@/components/icons/Icon.astro";
import { t, type Locale } from "@/i18n/utils";
import type { Playground } from "@/lib/content";

interface Props {
  locale: Locale;
  toy: Playground;
}

const { locale, toy } = Astro.props;
const data = toy.data;
---

<li class="toy">
  <h3 class="toy__name">
    <Icon name={data.icon} size={24} class="toy__icon" />
    <span>{data.name}</span>
  </h3>
  <p class="toy__tagline">{data.tagline[locale]}</p>
  <p class="toy__why">{data.why[locale]}</p>
  <ul class="toy__stack" aria-label={t("project.stack", locale)}>
    {data.stack.slice(0, 4).map((tech) => <li>{tech}</li>)}
  </ul>
  <p class="toy__links">
    <a href={data.repo} target="_blank" rel="noopener">
      <Icon name="code" size={16} />
      {t("playground.code", locale)}
      <span class="sr-only">{t("a11y.newTab", locale)}</span>
    </a>
    {
      data.liveUrl && (
        <a href={data.liveUrl} target="_blank" rel="noopener">
          <Icon name="external" size={16} />
          {t("playground.live", locale)}
          <span class="sr-only">{t("a11y.newTab", locale)}</span>
        </a>
      )
    }
  </p>
</li>

<style>
  /* A seção 05 é o oposto do ProjectCard de propósito. Sem capa, sem selo, sem sombra: o cartão é
     DESENHADO no papel, enquanto o de Projetos é uma peça apoiada nele. */
  .toy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-4) var(--space-4) var(--space-1);
    border: 1.5px dashed var(--border);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  /* O cartão não é clicável: isto é convite, não estado. Quem marca o elemento ativo é o anel de
     foco global de base.css. Com reduce, a rede do base.css já zera a transição. */
  .toy:hover,
  .toy:focus-within {
    border-color: var(--border-strong);
  }

  .toy__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .toy__icon {
    color: var(--accent-text); /* tinta de caneta: o ícone é o único desenho do cartão */
  }

  .toy__tagline {
    margin: 0 0 var(--space-2);
    color: var(--ink); /* sobre --surface: 14,80 claro · 14,65 escuro */
    font-size: var(--step-0);
    line-height: 1.45;
  }

  /* Um passo abaixo da tagline: é a nota, não a manchete. Serifa, não mono: a tagline real tem 85
     caracteres e em mono viraria 5 linhas na coluna de 222 px. */
  .toy__why {
    margin: 0 0 var(--space-3);
    color: var(--ink-muted); /* sobre --surface: 7,88 · 8,95 */
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .toy__stack {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    color: var(--ink-subtle); /* sobre --surface: 5,19 · 5,68 */
    font-family: var(--font-mono);
    font-size: var(--step--1);
    list-style: none;
  }

  /* Separador no item ANTERIOR: no ::before do seguinte, a linha quebrada começaria com "·".
     O `/ ""` é o texto alternativo vazio — o leitor de tela não anuncia o ponto. */
  .toy__stack li:not(:last-child)::after {
    padding-inline: 0.45em;
    color: var(--border-strong);
    content: "\00B7" / "";
  }

  .toy__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    margin: auto 0 0; /* cola no pé: os três cartões da linha alinham os links */
    padding-top: var(--space-1);
  }

  .toy__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px; /* alvo de toque */
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  @media (min-width: 1024px) {
    .toy {
      padding-inline: var(--space-5);
    }
  }
</style>
