---
// RF-20 / RN-05: credenciais sem badge, em lista simples abaixo do álbum. Data e verificação só
// aparecem se existirem no conteúdo (RN-06: nada é preenchido com valor plausível).
import Icon from "@/components/icons/Icon.astro";
import { t, type Locale } from "@/i18n/utils";
import type { Credential } from "@/lib/content";
import { formatDate } from "@/lib/dates";

interface Props {
  locale: Locale;
  credentials: Credential[];
}

const { locale, credentials } = Astro.props;
---

{
  credentials.length > 0 && (
    <div class="creds">
      <h3 class="creds__title">{t("credential.others", locale)}</h3>
      <ul class="creds__list">
        {credentials.map((credential) => {
          const data = credential.data;
          return (
            <li>
              <span class="creds__name">{data.name}</span>
              <span class="margin-note creds__meta">
                {data.issuer}
                {data.issuedAt && ` · ${formatDate(data.issuedAt, locale)}`}
              </span>
              {data.verifyUrl && (
                <a class="creds__verify" href={data.verifyUrl} target="_blank" rel="noopener">
                  {t("credential.verify", locale)}
                  <Icon name="external" size={16} />
                  <span class="sr-only">{t("a11y.newTab", locale)}</span>
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<style>
  .creds {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px dashed var(--border-strong);
  }

  .creds__title {
    margin: 0 0 var(--space-3);
    font-size: var(--step-0);
  }

  .creds__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .creds__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--space-3);
  }

  .creds__meta {
    color: var(--ink-subtle);
  }

  .creds__verify {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    font-weight: 600;
  }
</style>
