---
// Moldura comum das seções da home (RF-01): âncora, número de margem ("01"), h2 e a linha de
// apoio. O h2 é o mesmo rótulo do item da barra: quem toca em "Impact" chega em "Impact". A
// partir de lg o número vai para a coluna de margem do caderno (skill design-system-portfolio §4).
// A seção é nomeada pelo h2 (aria-labelledby); o número é enfeite (aria-hidden).
interface Props {
  id: string;
  index: number;
  title: string;
  subtitle?: string;
}

const { id, index, title, subtitle } = Astro.props;
const titleId = `${id}-title`;
const number = String(index).padStart(2, "0");
---

<section class="sec" id={id} aria-labelledby={titleId}>
  <div class="sec__inner">
    <p class="sec__label" aria-hidden="true">{number}</p>
    <h2 id={titleId} class="sec__title">{title}</h2>
    {subtitle && <p class="sec__lede">{subtitle}</p>}
    <div class="sec__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .sec {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .sec__inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .sec__label {
    margin: 0 0 var(--space-2);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .sec__title {
    margin: 0 0 var(--space-3);
    font-size: var(--step-4);
    line-height: 1.08;
  }

  .sec__lede {
    max-width: 31.8em;
    margin: 0 0 var(--space-7);
    color: var(--ink-muted);
  }

  .sec__body {
    min-width: 0;
  }

  /* Margem do caderno: rótulo à esquerda, linha vertical de caneta, conteúdo à direita. */
  @media (min-width: 1024px) {
    .sec__inner {
      position: relative;
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      column-gap: 2.5rem;
    }

    .sec__inner::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--page-gutter) + 9rem + 1.25rem);
      border-left: 1.5px solid color-mix(in srgb, var(--accent) 28%, transparent);
      content: "";
    }

    .sec__inner > * {
      grid-column: 2;
    }

    /* "> .sec__label" e não só ".sec__label": o Astro escopa com atributo, e a regra "> *" de
       cima ganharia na especificidade. */
    .sec__inner > .sec__label {
      grid-row: 1;
      grid-column: 1;
      padding-top: 0.9em;
      text-align: right;
    }
  }
</style>
