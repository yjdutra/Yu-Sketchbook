---
// RF-18 a RF-20: o álbum (ilha) e a lista simples. Aqui se resolve tudo o que a ilha precisa:
// textos no idioma da página, datas formatadas e as URLs do selo processadas por getImage().
import { getImage } from "astro:assets";
import CredentialList from "@/components/sections/CredentialList.astro";
import { HTML_LANG, t, tf, type Locale } from "@/i18n/utils";
import BadgeAlbum, { type AlbumBadge, type AlbumGroup } from "@/islands/BadgeAlbum";
import type { Credential } from "@/lib/content";
import { formatDate } from "@/lib/dates";
import { stickerRotation } from "@/lib/sticker";

interface Props {
  locale: Locale;
  album: Credential[];
  list: Credential[];
}

const { locale, album, list } = Astro.props;

// O selo aparece com até 200 px (12.5rem); 1x e 2x cobrem de celular a tela retina.
const STICKER_PX = 200;

async function toBadge(credential: Credential): Promise<AlbumBadge | null> {
  const data = credential.data;
  if (!data.badge) return null;
  const [one, two] = await Promise.all([
    getImage({ src: data.badge.sticker, width: STICKER_PX, format: "webp" }),
    getImage({ src: data.badge.sticker, width: STICKER_PX * 2, format: "webp" }),
  ]);
  const height = Math.round((data.badge.sticker.height / data.badge.sticker.width) * STICKER_PX);
  return {
    slug: credential.id,
    name: data.name,
    rotation: stickerRotation(credential.id),
    image: {
      src: one.src,
      srcSet: `${one.src} 1x, ${two.src} 2x`,
      width: STICKER_PX,
      height,
      alt: tf("credential.badgeAlt", locale, { name: data.name }),
    },
    issued: data.issuedAt ? formatDate(data.issuedAt, locale) : undefined,
    skills: data.skills.map((skill) => skill[locale]),
    verifyUrl: data.verifyUrl,
  };
}

// RF-18: agrupado por trilha (ou emissor, se não houver trilha), na ordem do primeiro selo.
const groups: AlbumGroup[] = [];
for (const credential of album) {
  const badge = await toBadge(credential);
  if (!badge) continue;
  const key = credential.data.track ?? credential.data.issuer;
  let group = groups.find((candidate) => candidate.id === key);
  if (!group) {
    group = {
      id: key,
      title: key,
      issuedBy: tf("credential.issuedBy", locale, { issuer: credential.data.issuer }),
      count: 0,
      countLabel: "",
      badges: [],
    };
    groups.push(group);
  }
  group.badges.push(badge);
}
// "1 badge" / "4 badges": a regra de plural é a do idioma, não um "=== 1" no código.
const plurals = new Intl.PluralRules(HTML_LANG[locale]);
for (const group of groups) {
  group.count = group.badges.length;
  const plural = plurals.select(group.count) === "one" ? "one" : "other";
  group.countLabel = tf(`credential.count.${plural}`, locale, { count: group.count });
}

const labels = {
  hint: t("credential.hint", locale),
  issued: t("credential.issued", locale),
  skills: t("credential.skills", locale),
  verify: t("credential.verify", locale),
  newTab: t("a11y.newTab", locale),
};
---

<div class="album-frame dot-grid">
  {groups.length > 0 && <BadgeAlbum client:visible groups={groups} labels={labels} />}
  <CredentialList locale={locale} credentials={list} />
</div>

<style>
  .album-frame {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-sunken);
  }
</style>
