---
// CTA em pílula de 48 px (skill design-system-portfolio §5, "Hero" e "Contato"). É sempre um
// link: todos os CTAs do site navegam (âncora, PDF, mailto, site externo), nenhum executa ação.
import Icon from "@/components/icons/Icon.astro";
import { t, type Locale } from "@/i18n/utils";

interface Props {
  href: string;
  locale: Locale;
  variant?: "primary" | "secondary" | "ghost";
  icon?: "arrow" | "download";
  // RF-09: externo abre em nova aba, com rel="noopener" e o aviso para leitor de tela.
  external?: boolean;
  download?: boolean;
  hreflang?: string;
  class?: string;
}

const {
  href,
  locale,
  variant = "primary",
  icon,
  external = false,
  download = false,
  hreflang,
  class: className,
} = Astro.props;
---

<a
  class:list={["btn", `btn--${variant}`, className]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  download={download ? "" : undefined}
  hreflang={hreflang}
>
  <slot />
  {icon && <Icon name={icon} size={16} />}
  {
    external && (
      <>
        <Icon name="external" size={16} />
        <span class="sr-only">{t("a11y.newTab", locale)}</span>
      </>
    )
  }
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 1.25rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn--primary {
    background-color: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
  }

  .btn--primary:hover {
    background-color: color-mix(in srgb, var(--accent) 88%, var(--ink));
  }

  .btn--secondary {
    border-color: var(--ink);
    color: var(--ink);
  }

  .btn--secondary:hover {
    background-color: var(--surface-sunken);
  }

  .btn--ghost {
    padding-inline: 0.5rem;
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .btn--ghost:hover {
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn:active {
      transform: translateY(1px);
    }
  }
</style>
