---
// Primeiro elemento focável da página: pula a barra fixa e vai ao <main id="main"> (RNF-03).
import { t, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a class="skip-link" href="#main">{t("skip.toMain", locale)}</a>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-3);
    left: var(--space-4);
    z-index: 50;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
    /* Fora da tela até receber foco; translate em vez de display para o Tab encontrá-lo. */
    transform: translateY(calc(-100% - var(--space-6)));
  }

  .skip-link:focus {
    transform: none;
  }
</style>
