---
// RF-07: troca o tema e grava a escolha. O tema da primeira pintura é do script inline do
// BaseLayout; este botão só muda o atributo depois. O rótulo diz a ação ("Switch to dark theme").
import Icon from "@/components/icons/Icon.astro";
import { t, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const toDark = t("theme.toDark", locale);
const toLight = t("theme.toLight", locale);
---

<button
  class="theme-toggle"
  type="button"
  aria-label={toDark}
  data-theme-toggle
  data-label-dark={toDark}
  data-label-light={toLight}
>
  <Icon name="moon" class="theme-toggle__moon" />
  <Icon name="sun" class="theme-toggle__sun" />
</button>

<script>
  // Script de componente: o Vite empacota e adia; nada aqui roda antes da primeira pintura.
  const root = document.documentElement;

  function sync(button: HTMLButtonElement) {
    const isDark = root.dataset.theme === "dark";
    const label = isDark ? button.dataset.labelLight : button.dataset.labelDark;
    if (label) button.setAttribute("aria-label", label);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    sync(button);
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Modo privado sem storage: o tema troca, só não persiste.
      }
      sync(button);
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background-color: var(--surface-sunken);
  }

  /* Lua no claro (a ação é escurecer), sol no escuro. */
  .theme-toggle :global(.theme-toggle__sun) {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.theme-toggle__sun) {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.theme-toggle__moon) {
    display: none;
  }
</style>
