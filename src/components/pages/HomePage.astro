---
// Home compartilhada por / e /pt: a diferença entre idiomas é só o conteúdo (RF-06).
// RF-01: Hero, Impacto, Projetos, Trajetória, Certificações e Contato, nessa ordem, cada seção
// com a âncora fixa de SECTION_IDS.
import Contact from "@/components/sections/Contact.astro";
import Credentials from "@/components/sections/Credentials.astro";
import Hero from "@/components/sections/Hero.astro";
import ImpactCard from "@/components/sections/ImpactCard.astro";
import ProjectCard from "@/components/sections/ProjectCard.astro";
import Section from "@/components/sections/Section.astro";
import Timeline from "@/components/sections/Timeline.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SECTION_IDS } from "@/i18n/ui";
import { t, type Locale } from "@/i18n/utils";
import {
  getCredentials,
  getImpactAchievements,
  getJourney,
  getProfile,
  getPublishedProjects,
  type Experience,
} from "@/lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [profile, impact, projects, journey, credentials] = await Promise.all([
  getProfile(),
  getImpactAchievements(),
  getPublishedProjects(),
  getJourney(),
  getCredentials(),
]);
const me = profile.data;

// A origem de cada cartão de Impacto (empresa · cargo · período). O getJourney() já garantiu que
// toda referência existe (RN-04).
const experiences = new Map<string, Experience>(
  journey.map(({ experience }) => [experience.id, experience]),
);
const impactCards = impact.flatMap((achievement) => {
  const experience = experiences.get(achievement.data.experience.id);
  return experience ? [{ achievement, experience }] : [];
});
const impactIds = new Set(impactCards.map(({ achievement }) => achievement.id));

// RF-22: JSON-LD Person. RN-07: sem telefone.
const site = Astro.site;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: me.name,
  jobTitle: me.headline[locale],
  email: `mailto:${me.email}`,
  url: site ? new URL(Astro.url.pathname, site).href : undefined,
  sameAs: [me.links.linkedin, me.links.github],
};
---

<BaseLayout
  title={`${me.name} · ${me.headline[locale]}`}
  description={t("meta.home.description", locale)}
  locale={locale}
  ogType="profile"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <Hero locale={locale} profile={profile} />

  <Section
    id={SECTION_IDS.impact}
    index={1}
    title={t("section.impact", locale)}
    subtitle={t("section.impact.subtitle", locale)}
  >
    <div class="impact-grid">
      {
        impactCards.map(({ achievement, experience }) => (
          <ImpactCard locale={locale} achievement={achievement} experience={experience} />
        ))
      }
    </div>
  </Section>

  <Section
    id={SECTION_IDS.projects}
    index={2}
    title={t("section.projects", locale)}
    subtitle={t("section.projects.subtitle", locale)}
  >
    <div class="project-list">
      {projects.map((project) => <ProjectCard locale={locale} project={project} />)}
    </div>
  </Section>

  <Section
    id={SECTION_IDS.journey}
    index={3}
    title={t("section.journey", locale)}
    subtitle={t("section.journey.subtitle", locale)}
  >
    <Timeline locale={locale} journey={journey} education={me.education} impactIds={impactIds} />
  </Section>

  <Section
    id={SECTION_IDS.credentials}
    index={4}
    title={t("section.credentials", locale)}
    subtitle={t("section.credentials.subtitle", locale)}
  >
    <Credentials locale={locale} album={credentials.album} list={credentials.list} />
  </Section>

  <Section
    id={SECTION_IDS.contact}
    index={5}
    title={t("section.contact", locale)}
    subtitle={t("section.contact.subtitle", locale)}
  >
    <Contact locale={locale} profile={profile} />
  </Section>
</BaseLayout>

<style>
  .impact-grid {
    display: grid;
    gap: var(--space-5);
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .impact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
