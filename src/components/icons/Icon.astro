---
// Ícones desenhados à mão na grade 24×24 (skill design-system-portfolio §3, "Ícones"). Sem pacote
// de ícones (CLAUDE.md). Decorativo sempre: o nome vai no controle ou no texto ao lado.
// O mesmo desenho, para a ilha React, mora em src/islands/icons.tsx.
interface Props {
  name:
    | "sun"
    | "moon"
    | "menu"
    | "arrow"
    | "arrow-up"
    | "download"
    | "external"
    | "code"
    | "lock"
    | "status-production"
    | "status-development"
    | "status-archived";
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
// Os pontos de status são menores e mais grossos, para a forma (cheio, metade, vazado) ler a 12 px.
const isStatus = name.startsWith("status-");
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={isStatus ? 2.2 : 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" />
      </>
    )
  }
  {name === "moon" && <path d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.9 7.9 0 1 0 10.1 10.1z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h11" />}
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "arrow-up" && <path d="M12 19V5M6 11l6-6 6 6" />}
  {name === "download" && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === "external" && <path d="M8 16 16 8M10 8h6v6" />}
  {name === "code" && <path d="M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5" />}
  {
    name === "lock" && (
      <>
        <rect x="5" y="10.5" width="14" height="10" rx="2" />
        <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
      </>
    )
  }
  {name === "status-production" && <circle cx="12" cy="12" r="5.5" fill="currentColor" />}
  {
    name === "status-development" && (
      <>
        <circle cx="12" cy="12" r="5.5" />
        <path d="M12 6.5a5.5 5.5 0 0 1 0 11z" fill="currentColor" />
      </>
    )
  }
  {name === "status-archived" && <circle cx="12" cy="12" r="5.5" />}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
